# Speedtest configuration.
#
# Copy this file to .env and adjust the values. Each variable is read by its
# command; the value shown after the `=` is used when it is unset or empty.
# Secret values are blank by default. Set only those you use, and never commit
# real credentials or license keys.

# --- Agent (cmd/agent) -------------------------------------------------------

# Path to the agent's YAML configuration file. A missing file uses the defaults
# documented in README.md.
SPEEDTEST_AGENT_CONFIG=/etc/speedtest-agent/config.yaml

# Path where the agent stores the node credential written by `agent enroll`.
# The file is created with mode 0600 and must never be group or world-readable;
# the agent refuses to start otherwise.
SPEEDTEST_AGENT_CREDENTIAL=/etc/speedtest-agent/credential

# Command-center origin the agent heartbeats, syncs its configuration and polls
# commands against. The address comes from the environment, never from code; set
# it to the same origin used with `agent enroll`.
SPEEDTEST_AGENT_CENTER=https://speedtest.example.com

# --- Command center (cmd/center) ---------------------------------------------

# Application environment. The default administrator seed command accepts only
# local or test; staging and production are always refused.
APP_ENV=local

# Listen address for the web UI and API.
SPEEDTEST_HTTP_ADDR=127.0.0.1:8080

# Optional development UI directory. Empty uses the UI embedded in the binary.
# The command-line flag -ui-dir can override this value for one run.
SPEEDTEST_UI_DIR=

# Required before node or enrollment-key issuance. Used to encrypt one-time API
# response replays; empty disables secure issuance (503). Create a private value
# with `openssl rand -base64 32`; never commit it.
APP_KEY=

# Sustained node bearer API limit; bursts allow up to 20 immediate requests.
SPEEDTEST_AGENT_REQUESTS_PER_MINUTE=120

# Owner session lifetime and in-process login limits. Requests are limited per
# remote client IP and normalized account email within a sliding time window.
SPEEDTEST_SESSION_TTL=12h
SPEEDTEST_LOGIN_MAX_ATTEMPTS=5
SPEEDTEST_LOGIN_WINDOW=15m
# Optional comma-separated CIDRs of trusted reverse proxies. Only these direct
# peers may supply X-Forwarded-For or X-Forwarded-Proto. Empty uses RemoteAddr
# and direct TLS only.
SPEEDTEST_TRUSTED_PROXY_CIDRS=

# Migration commands require a current-directory .env; existing environment
# variables take precedence. Local/test startup and seeding use speedtest_test or
# the worktree DB, never speedtest (live); the center checks the name and marker.
# PostgreSQL connection settings (shared Workspaces service). These are
# defaults for local development; point them at your environment as needed.
SPEEDTEST_DB_HOST=127.0.0.1
SPEEDTEST_DB_PORT=5432
SPEEDTEST_DB_NAME=speedtest_test
SPEEDTEST_DB_USER=speedtest

# Required for a real connection; no default. Never commit the real password.
SPEEDTEST_DB_PASSWORD=

# PostgreSQL TLS mode: disable, allow, prefer, require, verify-ca or verify-full.
SPEEDTEST_DB_SSLMODE=disable

# --- Offline geolocation (internal/center/geo) -------------------------------
# Relative paths use the center's working directory. Directory is created 0700,
# downloaded database files 0600. Never commit an MMDB or a licence key.
SPEEDTEST_GEOIP_CITY_DB=data/geoip/GeoLite2-City.mmdb
SPEEDTEST_GEOIP_ASN_DB=data/geoip/GeoLite2-ASN.mmdb
# Secret; no default. Settings (JOOST-31) will supply this through UpdaterSettings.
SPEEDTEST_GEOLITE2_LICENSE_KEY=
# Check on startup and every seven days; false disables downloads, not lookups.
SPEEDTEST_GEOLITE2_AUTO_UPDATE=true
# Optional MaxMind account ID. When set, use current Basic Auth download API;
# otherwise use the backwards-compatible licence-key API.
SPEEDTEST_GEOLITE2_ACCOUNT_ID=
# Download service origin, HTTPS required except loopback HTTP for tests.
SPEEDTEST_GEOLITE2_DOWNLOAD_URL=https://download.maxmind.com

# --- Online geolocation fallbacks (internal/center/geo) ---------------------
# Resolver order is ip_addresses cache, GeoLite2, ip-api, then IPinfo Lite.
# Provider calls happen only when GeoLite2 has no result. The ip-api free JSON
# endpoint is HTTP-only and limited to 45 requests/minute; this client spaces
# requests and observes its X-Rl/X-Ttl headers. ip-api's free endpoint is not
# licensed for commercial use; configure it only where its terms permit.
SPEEDTEST_GEO_IPAPI_ENABLED=true
SPEEDTEST_GEO_IPAPI_URL=http://ip-api.com/json
SPEEDTEST_GEO_IPAPI_REQUESTS_PER_MINUTE=45

# IPinfo Lite is opt-in and needs a private token. Lite returns country and
# basic ASN only. Its published free tier is unlimited; 0 disables local pacing.
# IPinfo Lite requires attribution when its data is displayed publicly.
SPEEDTEST_GEO_IPINFO_ENABLED=false
SPEEDTEST_GEO_IPINFO_URL=https://api.ipinfo.io/lite
SPEEDTEST_GEO_IPINFO_REQUESTS_PER_MINUTE=0
SPEEDTEST_GEO_IPINFO_TOKEN=

# Shared safeguards for enabled online providers.
SPEEDTEST_GEO_PROVIDER_TIMEOUT=5s
SPEEDTEST_GEO_PROVIDER_FAILURE_THRESHOLD=5
SPEEDTEST_GEO_PROVIDER_BREAKER_RESET=1m

# --- Ookla measurement engine (internal/agent/engine) ------------------------
# Executable path or name on PATH. Defaults to the official Ookla CLI.
SPEEDTEST_OOKLA_BINARY=speedtest
# JSON string array, passed as separate arguments without shell expansion.
# Replaces the default arguments; retain consent/JSON flags for the real CLI.
SPEEDTEST_OOKLA_ARGS='["--accept-license","--accept-gdpr","-f","json"]'
# Positive Go duration; an earlier caller context deadline still takes priority.
SPEEDTEST_OOKLA_TIMEOUT=120s

# LibreSpeed CLI. A blank server-list URL uses librespeed-cli's default list.
# Concurrent connections default to 4; a node's optional
# parallel_connections config value overrides this default.
SPEEDTEST_LIBRESPEED_BINARY=librespeed-cli
SPEEDTEST_LIBRESPEED_SERVER_JSON=
SPEEDTEST_LIBRESPEED_CONCURRENT=4
SPEEDTEST_LIBRESPEED_TIMEOUT=120s

# --- Agent installer and release downloads (internal/center/install) ----------
# Public address agents use to reach the center, written into GET /install.sh
# (never taken from the request). Set together with SPEEDTEST_RELEASE_DIR, the
# directory produced by `make release` (default dist/); leave both empty to disable.
SPEEDTEST_PUBLIC_URL=
SPEEDTEST_RELEASE_DIR=

# --- Agent result reporting library (internal/agent/report) -------------------
# Loaded by SpoolConfigFromEnv when the agent lifecycle composes the reporter.
# Private directory (0700); SQLite file is 0600. No credential is stored here.
SPEEDTEST_SPOOL_DIR=/etc/speedtest-agent/spool
# Maximum pending results and encoded payload bytes (excludes SQLite overhead).
# The quarantine has the same limits independently; freed pages are reused.
SPEEDTEST_SPOOL_MAX_RESULTS=10000
SPEEDTEST_SPOOL_MAX_BYTES=67108864
# Maximum measurement age; expired results drop oldest-first with a warning.
SPEEDTEST_SPOOL_MAX_AGE=168h

# --- speedtest-cli engine (internal/agent/engine) ------------------------------
# Used when a node's config sets engine: speedtestcli (Ubuntu package speedtest-cli).
SPEEDTEST_SPEEDTESTCLI_BINARY=
SPEEDTEST_SPEEDTESTCLI_TIMEOUT=

# Notification transports; channel switches/destinations/passwords live in Settings.
# SMTP address default: shared Mailpit on the development host. Override for deployment.
SPEEDTEST_SMTP_ADDR=127.0.0.1:11025
SPEEDTEST_SMTP_FROM=speedtest@example.com
# SMTP authentication username (default empty); password is notify.email.secret.
SPEEDTEST_SMTP_USER=
# Telegram API origin (default official API; override only for a trusted test gateway).
SPEEDTEST_TELEGRAM_URL=https://api.telegram.org
