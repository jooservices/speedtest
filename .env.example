# Speedtest configuration.
#
# Copy this file to .env and adjust the values. Every variable listed here is
# read from the environment at startup; the value shown after the `=` is the
# default used when the variable is unset or empty. Only SPEEDTEST_DB_PASSWORD
# has no default: set it before connecting to a real database, and never commit
# the real value (it must stay out of this repository).

# --- Node / agent (cmd/agent) ------------------------------------------------

# Human-readable node name shown in the command center.
SPEEDTEST_NODE_NAME=node

# Expected download and upload speeds the node is compared against, in Mbps.
SPEEDTEST_NODE_EXPECTED_DOWNLOAD_MBPS=0
SPEEDTEST_NODE_EXPECTED_UPLOAD_MBPS=0

# How often the node runs a speed test (Go duration, e.g. "30m", "1h").
SPEEDTEST_NODE_INTERVAL=30m

# Command-center URL the node reports its results to.
SPEEDTEST_CENTER_URL=http://127.0.0.1:8080

# --- Command center (cmd/center) ---------------------------------------------

# Listen address for the web UI and API.
SPEEDTEST_HTTP_ADDR=:8080

# PostgreSQL connection settings (shared Workspaces service). These are
# defaults for local development; point them at your environment as needed.
SPEEDTEST_DB_HOST=127.0.0.1
SPEEDTEST_DB_PORT=5432
SPEEDTEST_DB_NAME=speedtest
SPEEDTEST_DB_USER=speedtest

# Required for a real connection; no default. Never commit the real password.
SPEEDTEST_DB_PASSWORD=

# PostgreSQL TLS mode: disable, allow, prefer, require, verify-ca or verify-full.
SPEEDTEST_DB_SSLMODE=disable

# --- Offline geolocation (internal/center/geo) -------------------------------
# Relative paths use the center's working directory. Directory is created 0700,
# downloaded database files 0600. Never commit an MMDB or a licence key.
SPEEDTEST_GEOIP_CITY_DB=data/geoip/GeoLite2-City.mmdb
SPEEDTEST_GEOIP_ASN_DB=data/geoip/GeoLite2-ASN.mmdb
# Secret; no default. Settings (JOOST-31) will supply this through UpdaterSettings.
SPEEDTEST_GEOLITE2_LICENSE_KEY=
# Check on startup and every seven days; false disables downloads, not lookups.
SPEEDTEST_GEOLITE2_AUTO_UPDATE=true
# Optional MaxMind account ID. When set, use current Basic Auth download API;
# otherwise use the backwards-compatible licence-key API.
SPEEDTEST_GEOLITE2_ACCOUNT_ID=
# Download service origin, HTTPS required except loopback HTTP for tests.
SPEEDTEST_GEOLITE2_DOWNLOAD_URL=https://download.maxmind.com
