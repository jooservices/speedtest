# Speedtest configuration.
#
# Copy this file to .env and adjust the values. Each variable is read by its
# command; the value shown after the `=` is used when it is unset or empty.
# Only SPEEDTEST_DB_PASSWORD has no default: set it before connecting to a real
# database, and never commit the real value (it must stay out of this repository).

# --- Agent (cmd/agent) -------------------------------------------------------

# Path to the agent's YAML configuration file. A missing file uses the defaults
# documented in README.md.
SPEEDTEST_AGENT_CONFIG=/etc/speedtest-agent/config.yaml

# Path where the agent stores the node credential written by `agent enroll`.
# The file is created with mode 0600 and must never be group or world-readable;
# the agent refuses to start otherwise.
SPEEDTEST_AGENT_CREDENTIAL=/etc/speedtest-agent/credential

# --- Command center (cmd/center) ---------------------------------------------

# Listen address for the web UI and API.
SPEEDTEST_HTTP_ADDR=:8080

# PostgreSQL connection settings (shared Workspaces service). These are
# defaults for local development; point them at your environment as needed.
SPEEDTEST_DB_HOST=127.0.0.1
SPEEDTEST_DB_PORT=5432
SPEEDTEST_DB_NAME=speedtest
SPEEDTEST_DB_USER=speedtest

# Required for a real connection; no default. Never commit the real password.
SPEEDTEST_DB_PASSWORD=

# PostgreSQL TLS mode: disable, allow, prefer, require, verify-ca or verify-full.
SPEEDTEST_DB_SSLMODE=disable
